<Project Sdk="Microsoft.NET.Sdk">
  <!-- Corre la lógica del juego y sus pruebas sin abrir Unity: `dotnet test dotnet/Core.Tests`.
       Los fuentes viven en Assets/ (Unity los compila también); aquí solo se enlazan. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Penales</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Penales/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../Assets/Penales/Tests/EditMode/**/*.cs" LinkBase="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
